<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  body { margin: 0; padding: 24px; background: #121417; font-family: "JetBrains Mono", Consolas, monospace; display: flex; gap: 12px; align-items: center; justify-content: center; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: all 0.15s ease;
  }
  .btn-primary { background: #4ADE80; color: #0F172A; border-color: #4ADE80; }
  .btn-primary:hover { background: #22C55E; }
  .btn-cmd { background: rgba(250, 204, 21, 0.08); color: #FACC15; border-color: #FACC15; }
  .btn-cmd:hover { background: rgba(250, 204, 21, 0.2); }
  .btn-save { background: #007ACC; color: #FFFFFF; border-color: #007ACC; }
  .btn-save:hover { background: #0066B8; }
  .btn-stop { background: #EF4444; color: #FFFFFF; border-color: #EF4444; }
  .btn-stop:hover { background: #DC2626; }
</style>
</head>
<body>
  <button class="btn btn-primary">[Chạy nền]</button>
  <button class="btn btn-cmd">[Mở CMD]</button>
  <button class="btn btn-save">[LƯU LÊN PC *]</button>
  <button class="btn btn-stop">[Dừng PID: 4092]</button>
</body>
</html>
