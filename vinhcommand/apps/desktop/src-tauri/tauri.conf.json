{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinhCommand",
  "version": "1.0.0",
  "identifier": "com.vinhcommand.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VinhCommand",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "titleBarStyle": "overlay",
        "hiddenTitle": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": "-",
      "entitlements": null
    }
  },
  "plugins": {
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA/*", "$HOME/*", "$TEMP/*"]
    },
    "shell": {
      "all": true,
      "open": true,
      "scope": [
        {
          "name": "code",
          "cmd": "code",
          "args": ["--wait", "--folder-uri", "$1"]
        },
        {
          "name": "git",
          "cmd": "git",
          "args": ["*"]
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": ["*"]
        },
        {
          "name": "pnpm",
          "cmd": "pnpm",
          "args": ["*"]
        },
        {
          "name": "cargo",
          "cmd": "cargo",
          "args": ["*"]
        }
      ]
    },
    "process": {
      "all": true,
      "scope": {
        "allowlist": ["code", "git", "npm", "pnpm", "cargo", "node", "python3", "python"]
      }
    }
  }
}